rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isModerator() {
      return isSignedIn() && request.auth.token.role == 'moderator';
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    // Quiz source data is read-only for both staff roles in this phase.
    // Emulator seed tooling uses Admin SDK and never relies on client writes.
    match /quizzes/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Live control state is private. All mutations go through trusted callable
    // Functions using Admin SDK and are never accepted directly from clients.
    match /sessions/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    // A projector may fetch one unguessable session document by id, but cannot
    // enumerate sessions. Only server code publishes this sanitized snapshot.
    match /publicSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /events/{document=**} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /media/{document=**} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Staff can see only their own profile; role and other user management is
    // admin-only. Custom claims remain the source of authorization.
    match /users/{userId} {
      allow read: if isAdmin() || (isStaff() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Everything not named above remains denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
