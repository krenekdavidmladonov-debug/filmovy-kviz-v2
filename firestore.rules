rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isModerator() {
      return isSignedIn() && request.auth.token.role == 'moderator';
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    // Quiz source data is read-only for both staff roles in this phase.
    // Emulator seed tooling uses Admin SDK and never relies on client writes.
    match /quizzes/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Live control state is private. All mutations go through trusted callable
    // Functions using Admin SDK and are never accepted directly from clients.
    match /sessions/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    // A projector may fetch one unguessable session document by id, but cannot
    // enumerate sessions. Only server code publishes this sanitized snapshot.
    match /publicSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Event roots are private operational records. Admins and moderators may
    // read them, but every authoritative mutation goes through a Function.
    match /events/{eventId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Registration contact data is staff-only. Creation, management-link
    // mutations, capacity accounting, and administrative cancellation are
    // trusted Functions operations; direct browser writes are always denied.
    match /events/{eventId}/registrations/{registrationId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Uniqueness reservations contain internal transaction state and are
    // never browser-readable, including by staff.
    match /events/{eventId}/registrationNames/{nameHash} {
      allow read, write: if false;
    }

    // Internal scoring is staff-readable; only the callable writes scores/history.
    match /events/{eventId}/scores/{scoreId} {
      allow read: if isStaff();
      allow write: if false;
      match /history/{entryId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Every other event child path remains private.
    match /events/{eventId}/{document=**} {
      allow read, write: if false;
    }

    // Immutable quiz snapshots are private inputs for staff workflows.
    // They include answers and legacy presentation data and are server-written.
    match /quizSnapshots/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Anonymous clients may query the allowlisted event projection. Browsers
    // never author public availability or event authority.
    match /publicEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /media/{document=**} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Staff can see only their own profile; role and other user management is
    // admin-only. Custom claims remain the source of authorization.
    match /users/{userId} {
      allow read: if isAdmin() || (isStaff() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Everything not named above remains denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
