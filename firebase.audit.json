{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.audit.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9299 },
    "functions": { "host": "127.0.0.1", "port": 5201 },
    "firestore": { "host": "127.0.0.1", "port": 8280, "websocketPort": 9280 },
    "hosting": { "host": "127.0.0.1", "port": 5200 },
    "storage": { "host": "127.0.0.1", "port": 9399 },
    "eventarc": { "host": "127.0.0.1", "port": 9499 },
    "tasks": { "host": "127.0.0.1", "port": 9599 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4200 },
    "hub": { "host": "127.0.0.1", "port": 4600 },
    "logging": { "host": "127.0.0.1", "port": 4700 },
    "singleProjectMode": true
  }
}
