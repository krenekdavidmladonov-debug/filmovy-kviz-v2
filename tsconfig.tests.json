{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "tools/migration-v1/test/**/*.ts", "tools/event-night/**/*.ts", "apps/web/src/vite-env.d.ts", "playwright.config.ts", "vitest.config.ts", "vitest.rules.config.ts", "vitest.access-rules.config.ts"]
}
