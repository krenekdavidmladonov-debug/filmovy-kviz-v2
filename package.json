{
  "name": "filmovy-kviz-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @filmovy-kviz/web dev",
    "emulators": "firebase emulators:start --project demo-filmovy-kviz-v2",
    "event-night:emulators": "firebase emulators:start --project demo-filmovy-kviz-v2 --import .local-data/event-night/emulator-data",
    "event-night:emulators:fresh": "firebase emulators:start --project demo-filmovy-kviz-v2",
    "event-night:export": "firebase emulators:export .local-data/event-night/export-staging --project demo-filmovy-kviz-v2",
    "event-night:candidate": "vitest run --config tools/event-night/vitest.config.ts --disableConsoleIntercept",
    "seed:auth": "pnpm --filter @filmovy-kviz/quiz-domain build && pnpm --filter @filmovy-kviz/functions build && node tools/local-emulator-environment.mjs full functions/lib/dev/seed-auth.js",
    "seed:quizzes": "pnpm --filter @filmovy-kviz/quiz-domain build && pnpm --filter @filmovy-kviz/functions build && node tools/local-emulator-environment.mjs firestore functions/lib/dev/seed-quizzes.js",
    "seed:emulators": "pnpm seed:auth && pnpm seed:quizzes",
    "test:rules": "firebase emulators:exec --only firestore --project demo-filmovy-kviz-v2 \"pnpm test:rules:run\"",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:functions": "vitest run --config vitest.config.ts tests/liveSession.test.ts tests/quizEditor.test.ts tests/events.test.ts",
    "test:pdf": "vitest run --config vitest.config.ts tests/printCenter.test.ts",
    "test:pdf-security": "vitest run --config vitest.config.ts tests/printCenterSecurity.test.ts",
    "test:functions:print": "vitest run --config vitest.config.ts tests/printCenter.test.ts tests/printCenterSecurity.test.ts",
    "test:registrations": "vitest run --config vitest.config.ts tests/registrations.test.ts tests/events.test.ts tests/printCenterSecurity.test.ts",
    "test:e2e:registrations": "node tools/local-emulator-environment.mjs full tests/e2e/registrations-emulator.mjs",
    "test:e2e:registration-email": "node tools/local-emulator-environment.mjs full tests/e2e/registration-email-emulator.mjs",
    "test:e2e:registration-email-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/registration-email.config.ts",
    "test:e2e:live": "node tools/local-emulator-environment.mjs full tests/e2e/live-session-emulator.mjs",
    "test:e2e:editor": "node tools/local-emulator-environment.mjs full tests/e2e/quiz-editor-emulator.mjs",
    "test:e2e:editor-core-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/editor-core-workflow.config.ts --grep @seeded",
    "test:e2e:editor-core-empty-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/editor-core-workflow.config.ts --grep @empty-library",
    "test:e2e:events": "node tools/local-emulator-environment.mjs full tests/e2e/events-emulator.mjs && pnpm test:e2e:scoring",
    "test:e2e:scoring": "node tools/local-emulator-environment.mjs full tests/e2e/event-scoring-emulator.mjs",
    "test:e2e:scoring-browser": "playwright test --config tests/browser/event-scoring.config.ts",
    "test:e2e:print": "node tools/local-emulator-environment.mjs full tests/e2e/print-center-emulator.mjs",
    "test:e2e:print-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test tests/browser/print-center.spec.ts --config playwright.config.ts",
    "test:e2e:registrations-browser": "playwright test tests/browser/registrations.spec.ts --config playwright.config.ts",
    "test:e2e:events-migrated": "node tools/local-emulator-environment.mjs full tests/e2e/events-migrated-emulator.mjs",
    "test:e2e:editor-migrated": "node tools/local-emulator-environment.mjs full tests/e2e/quiz-editor-migrated-emulator.mjs",
    "test:e2e:production-preview": "node tests/e2e/production-preview-smoke.mjs",
    "test:e2e:event-night-health": "node tools/event-night/health-check.mjs",
    "test:e2e:browser": "playwright test --config playwright.config.ts",
    "migration:v1:inspect": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/cli.js inspect",
    "migration:v1:extract": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/extract-library.js",
    "migration:v1:inventory": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/inventory.js",
    "migration:v1:behavior-inventory": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/behavior-analysis.js",
    "migration:v1:validate": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/cli.js validate",
    "migration:v1:dry-run": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/cli.js dry-run",
    "migration:v1:emulator": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/cli.js emulator",
    "migration:v1:verify-emulator": "pnpm --filter @filmovy-kviz/migration-v1... build && node tools/migration-v1/lib/verify-emulator.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @filmovy-kviz/quiz-domain build && tsc -p tsconfig.tests.json --noEmit --pretty false && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "test:e2e:gmail-delivery": "node tools/local-emulator-environment.mjs full tests/e2e/gmail-delivery-emulator.mjs",
    "test:e2e:event-team-email": "node tools/local-emulator-environment.mjs full tests/e2e/event-team-email-emulator.mjs",
    "test:e2e:event-team-email-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/event-team-email.config.ts",
    "test:e2e:media": "node tools/local-emulator-environment.mjs full tests/e2e/media-emulator.mjs",
    "test:e2e:media-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/media-storage.config.ts",
    "test:e2e:complete-editor": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/complete-editor.config.ts",
    "test:e2e:complete-editor-performance": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/complete-editor-performance.config.ts",
    "test:e2e:whole-evening": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/whole-evening-design.config.ts",
    "test:e2e:whole-evening-performance": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/whole-evening-performance.config.ts",
    "test:e2e:show-mode": "node tools/local-emulator-environment.mjs full tests/e2e/show-mode-emulator.mjs",
    "test:e2e:show-audio": "node tools/local-emulator-environment.mjs full tests/e2e/show-audio-emulator.mjs",
    "test:e2e:show-browser": "node tools/local-emulator-environment.mjs full node_modules/@playwright/test/cli.js test --config tests/browser/show-mode.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "firebase": "^12.2.1",
    "firebase-tools": "^15.28.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "jsqr": "1.4.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
