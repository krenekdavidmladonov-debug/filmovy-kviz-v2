{
  "name": "filmovy-kviz-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @filmovy-kviz/web dev",
    "emulators": "firebase emulators:start --project demo-filmovy-kviz-v2",
    "seed:auth": "pnpm --filter @filmovy-kviz/quiz-domain build && pnpm --filter @filmovy-kviz/functions build && node tools/local-emulator-environment.mjs auth functions/lib/dev/seed-auth.js",
    "seed:quizzes": "pnpm --filter @filmovy-kviz/quiz-domain build && pnpm --filter @filmovy-kviz/functions build && node tools/local-emulator-environment.mjs firestore functions/lib/dev/seed-quizzes.js",
    "seed:emulators": "pnpm seed:auth && pnpm seed:quizzes",
    "test:rules": "firebase emulators:exec --only firestore --project demo-filmovy-kviz-v2 \"pnpm test:rules:run\"",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:functions": "vitest run --config vitest.config.ts tests/liveSession.test.ts tests/quizEditor.test.ts tests/events.test.ts",
    "test:e2e:live": "node tools/local-emulator-environment.mjs full tests/e2e/live-session-emulator.mjs",
    "test:e2e:editor": "node tools/local-emulator-environment.mjs full tests/e2e/quiz-editor-emulator.mjs",
    "test:e2e:events": "node tools/local-emulator-environment.mjs full tests/e2e/events-emulator.mjs",
    "test:e2e:events-migrated": "node tools/local-emulator-environment.mjs full tests/e2e/events-migrated-emulator.mjs",
    "test:e2e:editor-migrated": "node tools/local-emulator-environment.mjs full tests/e2e/quiz-editor-migrated-emulator.mjs",
    "test:e2e:browser": "playwright test --config playwright.config.ts",
    "migration:v1:inspect": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/cli.js inspect",
    "migration:v1:extract": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/extract-library.js",
    "migration:v1:inventory": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/inventory.js",
    "migration:v1:behavior-inventory": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/behavior-analysis.js",
    "migration:v1:validate": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/cli.js validate",
    "migration:v1:dry-run": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/cli.js dry-run",
    "migration:v1:emulator": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/cli.js emulator",
    "migration:v1:verify-emulator": "pnpm --filter @filmovy-kviz/migration-v1 build && node tools/migration-v1/lib/verify-emulator.js",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit --pretty false && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "firebase": "^12.2.1",
    "firebase-tools": "^15.28.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
